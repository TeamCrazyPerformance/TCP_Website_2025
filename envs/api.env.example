# Existing website API variables belong in envs/api.env. These additional values
# enable only the technical-article facade. The service token must exactly match
# PIPELINE_SERVICE_TOKEN on tech-article-pipeline.
TECH_ARTICLE_PIPELINE_BASE_URL=http://tech-article-pipeline:8080
PIPELINE_SERVICE_TOKEN=replace-with-the-same-long-random-service-token
TECH_ARTICLE_PIPELINE_READ_TIMEOUT_MS=2000
TECH_ARTICLE_PIPELINE_WRITE_TIMEOUT_MS=5000

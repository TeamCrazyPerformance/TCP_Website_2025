# Reference inventory for root .env. Run set_env.sh instead of copying placeholder
# secrets. Never commit the populated root .env.

# INTERNAL / AUTO-GENERATED
PIPELINE_SERVICE_TOKEN=
TECH_ARTICLE_MYSQL_PASSWORD=
TECH_ARTICLE_MYSQL_ROOT_PASSWORD=

# MySQL and worker tuning
TECH_ARTICLE_MYSQL_DATABASE=tech_articles
TECH_ARTICLE_MYSQL_USER=pipeline
TECH_ARTICLE_MYSQL_POOL_SIZE=5
PIPELINE_WORKER_CONCURRENCY=1
PIPELINE_WORKER_POLL_SECONDS=1
PIPELINE_WORKER_LEASE_SECONDS=60
PIPELINE_JOB_MAX_ATTEMPTS=3

# EXTERNAL / OPERATOR INPUT (defaults may be accepted interactively)
CRAWLER_PUBLIC_URL=https://teamcrazyperformance.com/
CRAWLER_CONTACT=seoultech.tcp@gmail.com

# EXTERNAL / OPERATOR INPUT. Required in prod, optional in dev.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Compose-owned NestJS facade values (not copied into pipeline env)
TECH_ARTICLE_PIPELINE_BASE_URL=http://tech-article-pipeline:8080
TECH_ARTICLE_PIPELINE_READ_TIMEOUT_MS=2000
TECH_ARTICLE_PIPELINE_WRITE_TIMEOUT_MS=5000

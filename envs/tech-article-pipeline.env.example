# Copy these values into the deployment secret environment (or the root .env
# used by Docker Compose). Never commit the populated values.

# Required secrets
PIPELINE_SERVICE_TOKEN=replace-with-a-long-random-service-token
TECH_ARTICLE_MYSQL_PASSWORD=replace-with-a-random-password
TECH_ARTICLE_MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password

# MySQL and worker tuning
TECH_ARTICLE_MYSQL_DATABASE=tech_articles
TECH_ARTICLE_MYSQL_USER=pipeline
TECH_ARTICLE_MYSQL_POOL_SIZE=5
PIPELINE_WORKER_CONCURRENCY=1
PIPELINE_WORKER_POLL_SECONDS=1
PIPELINE_WORKER_LEASE_SECONDS=60
PIPELINE_JOB_MAX_ATTEMPTS=3

# Required before enabling the Cloudflare source adapter
CRAWLER_PUBLIC_URL=https://replace-with-your-public-service.example/crawler
CRAWLER_CONTACT=replace-with-an-operational-email@example.com

# Required for successful enrichment; the container can become ready without it
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
